     // Maximum size is limited by the maximum length of a x86_64 / arm64 jump.
     size_t code_cache_size = 128 * 1024 * 1024;  // bytes
 
+    /// Optional caller-owned code memory of code_cache_size bytes (arm64 backend only).
+    /// code_cache_execute is the executable view and code_cache_write a writable alias of
+    /// the same pages. When both are set the JIT neither allocates nor reprotects code
+    /// memory, and fastmem is unavailable.
+    void* code_cache_execute = nullptr;
+    void* code_cache_write = nullptr;
