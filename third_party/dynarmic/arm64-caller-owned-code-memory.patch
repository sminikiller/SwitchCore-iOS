 namespace Dynarmic::Backend::Arm64 {
 
+// Code memory with separate writable and executable views. Without caller-owned memory
+// both views are one oaknut::CodeBlock (MAP_JIT on macOS).
+class CodeMemory {
+public:
+    CodeMemory(size_t code_size, void* execute, void* write)
+            : size(code_size) {
+        if (execute && write) {
+            xmem = static_cast<u32*>(execute);
+            wmem = static_cast<u32*>(write);
+        } else {
+            block.emplace(code_size);
+            xmem = wmem = block->ptr();
+        }
+    }
+
+    u32* xptr() const { return xmem; }
+    u32* wptr() const { return wmem; }
+    oaknut::CodeBlock* owned() { return block ? &*block : nullptr; }
+
+    void protect() {
+        if (block) {
+            block->protect();
+        }
+    }
+
+    void unprotect() {
+        if (block) {
+            block->unprotect();
+        }
+    }
+
+    void invalidate(u32* mem, size_t length) {
+        if (block) {
+            block->invalidate(mem, length);
+            return;
+        }
+#if defined(__APPLE__)
+        sys_icache_invalidate(mem, length);
+#else
+        __builtin___clear_cache(reinterpret_cast<char*>(mem), reinterpret_cast<char*>(mem) + length);
+#endif
+    }
+
+    void invalidate_all() { invalidate(xmem, size); }
+
+private:
+    std::optional<oaknut::CodeBlock> block;
+    u32* xmem = nullptr;
+    u32* wmem = nullptr;
+    size_t size;
+};
+
 class AddressSpace {
 public:
-    explicit AddressSpace(size_t code_cache_size);
+    explicit AddressSpace(size_t code_cache_size, void* code_execute = nullptr, void* code_write = nullptr);
     virtual ~AddressSpace();
 
     virtual IR::Block GenerateIR(IR::LocationDescriptor) const = 0;
@@ -70,7 +122,7 @@
     FakeCall FastmemCallback(u64 host_pc);
 
     const size_t code_cache_size;
-    oaknut::CodeBlock mem;
+    CodeMemory mem;
     oaknut::CodeGenerator code;
 
     // A IR::LocationDescriptor will have one current CodePtr.
